# Matriz local configuration — example with FICTITIOUS values.
# Copy to .env (git-ignored) and adjust: cp .env.example .env
# Read by Docker Compose (database container) and by the backend.

# PostgreSQL (container and backend connection)
MATRIZ_DB_HOST=localhost
MATRIZ_DB_PORT=5432
MATRIZ_DB_NAME=matriz
MATRIZ_DB_USER=matriz
MATRIZ_DB_PASSWORD=change-me-local-only

# Backend HTTP port (the Vite dev server proxies /api to it)
MATRIZ_API_PORT=8080

# Demo data: inserted once, only when the users table is empty; never deleted.
MATRIZ_SEED_DEMO=true
# Shared password of all demo accounts (fictitious, local use only).
MATRIZ_DEMO_PASSWORD=MatrizDemo#2026

# Optional, Docker Compose only (docker compose up -d --build):
# host port of the SPA container (default 5173)
# MATRIZ_WEB_PORT=5173
# PEM file with an extra CA certificate for the frontend image build (TLS-inspecting proxy)
# MATRIZ_EXTRA_CA_CERT=/path/outside/the/repository/ca.pem
